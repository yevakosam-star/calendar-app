# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Anthropic API key for the "Ask AI" feature (console.anthropic.com > API Keys).
# Server-side only — set this in the Vercel dashboard (Project Settings > Environment
# Variables), NOT here. It must never carry the EXPO_PUBLIC_ prefix, or it would be
# bundled into the client-side app and visible to anyone who opens the site.
# ANTHROPIC_API_KEY=
